# ── 멀티플랫폼 블로그 발행 설정 ─────────────────────────────
# 이 파일을 .env 로 복사해서 채우세요:  cp .env.example .env
# 각 플랫폼은 해당 키가 있을 때만 발행 대상으로 켜집니다(없으면 그냥 건너뜀).

# ── Blogger (한국, 현재 사용) ────────────────────────────
BLOG_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Dev.to (글로벌·개발, 제일 쉬움) ──────────────────────
# dev.to → Settings → Extensions → "Generate API Key"
DEVTO_API_KEY=

# ── WordPress (일반 대중·소유 허브) ──────────────────────
# 관리자 → 프로필 → "응용 프로그램 비밀번호(Application Password)" 생성
WP_URL=            # 예: https://your-site.com
WP_USER=
WP_APP_PASSWORD=

# ── Hatena Blog (일본) ───────────────────────────────────
# hatena.ne.jp → 설정 → AtomPub 에서 API 키 확인
HATENA_ID=         # 하테나 ID
HATENA_BLOG_ID=    # 예: example.hatenablog.com
HATENA_API_KEY=

# ── Matters (대만/번체 중문) ─────────────────────────────
MATTERS_TOKEN=

# ── 네이버 ───────────────────────────────────────────────
# 네이버는 공식 API가 없어 자동 발행 불가. 별도 키 없음.
# 관리 UI(localhost:4599)에서 글 열고 '📋 네이버 복사' → 네이버 에디터에 붙여넣기.

# ── 발행 속도/안전 (봇차단 재발방지) ─────────────────────
# docs/blogger-bot-block-guide.md 참고. 신생 블로그 권장값.
MAX_POSTS_PER_DAY=3          # 하루 발행 상한
PUBLISH_MIN_GAP_MS=2700000   # 글 간 최소 간격(45분)
PUBLISH_MAX_GAP_MS=5400000   # 글 간 최대 간격(90분)
BLOCK_COOLDOWN_HOURS=24      # 403 차단 시 쿨다운

# ── 이미지 호스팅 base (jsDelivr) ────────────────────────
# ASSET_BASE_URL=https://cdn.jsdelivr.net/gh/<user>/<repo>@main
